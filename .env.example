# ==============================================================
# SmartBill v3.0 - Environment Configuration
# ==============================================================

# Google Gemini AI API Configuration
# คีย์ Google API สำหรับเชื่อมต่อ Gemini Vision OCR
GEMINI_API_KEY=your_gemini_api_key_here

# ปรับเปลี่ยนรุ่นโมเดล Gemini ได้ที่ตัวแปรนี้:
# ตัวเลือกที่แนะนำ:
# - gemini-3.1-flash-lite (เร็วสุด, ประหยัดโควต้า, เหมาะกับใบเสร็จ)
# - gemini-2.5-flash
# - gemini-3.5-flash
GEMINI_MODEL=gemini-3.1-flash-lite

# SmartBill Central Identity & Access Management (IAM) API Gateway
IAM_API_URL=https://smartbill-usersadmin-api.pingly69.workers.dev/api

# LINE LIFF & App Settings
LIFF_ID=2009016720-6dg4Pumx
ENVIRONMENT=development
ALLOW_DEV_MOCK=true
